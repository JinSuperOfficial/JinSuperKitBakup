# 密钥：等同于账号密码，绝不提交
.env
.env.local
.env.*.local

# 部署产物（本地产物，由 prep-deploy 生成）
dist/
.deploy-changed.txt
.newthings-filelist.txt

# 依赖与缓存
node_modules/
# Node 运行时的压缩包（434MB，GitHub 单文件上限 100MB 会直接拒收）
node.tar
node-*.tar

.npm-cache/
build/node_modules/
.deno-cache/
# .npmrc 里把 npm 缓存写成了 Windows 绝对路径（F:\@Project\...）。
# 在类 Unix 环境下会被当成**相对目录名**，在仓库里长出一个怪名字的缓存文件夹 ——
# 一律忽略，别让它进备份。
F\:\\@Project*/

# 部署工具的日志（TUI 每次运行留一份，不属于源码）
.deploy-logs/

# 测试留下的临时站点（build/test-dom.mjs 搭的）
build/.tmp-site/

# 桌面版（desktop/）：打包产物与冒烟截图都不进备份
desktop/release/
desktop/.smoke/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
*.log

# Windows 下载标记（ADS 泄漏成真文件，带冒号，Windows 上根本签不出来）
*:Zone.Identifier

# 跨网同步：打包时注进去的配置（含令牌）与本地收件箱/缓存
desktop/build/sync-config.json
sync/inbox/
sync/cache/
console/logs/

# ── 移动端（android/） ──────────────────────────────────────────────
# 打包产物、Gradle 状态、本机 SDK 路径：都不进备份
android/build/
android/app/build/
android/.gradle/
android/.kotlin/
android/local.properties
android/release/
android/.cxx/
# 构建期从站点拷进来的离线副本与编辑器界面 —— 源头在 jinsuper.rth1.xyz/ 与
# desktop/src/ui/hwk/，由 android/tools/sync-site-assets.mjs 生成，别提交副本
android/app/src/main/assets/site/
android/app/src/main/assets/hwk-ui/
# ★ 令牌：打包时注入，**绝不入库**（对齐 desktop/build/sync-config.json 的处理）
android/app/src/main/assets/sync-config.json
# ★ 签名文件：丢了就永远无法覆盖升级。
#   **这个文件要进备份仓库**（`部署.cmd bakup` 走的 git 是按 .gitignore 过滤的）——
#   它是口令保护的，安全的是**口令**，不是文件本身；口令存密码管理器，绝不写进任何被提交的文件。
#   下面这条 `!` 就是把它从「一律不认 jks」里单独捞出来。
android/keystore/*.jks
*.jks
*.keystore
!android/keystore/jinsuper.jks

# 但要挡掉「别的」keystore：不是这套签名体系的钥匙不该被顺手带进来。
# （`android/keystore/` 里除了 jinsuper.jks 之外的任何 jks 都进不来。）
android/keystore/*.jks.bak
android/keystore/*.old
android/keystore/*.keystore
# 有人会把口令写成一份 keystore.properties（Gradle 的常见做法）—— 一并挡掉，
# 免得它落在 `android/` 下被同步/备份流程扫走。**口令不要写进 android/gradle.properties**
# （那个文件是入库的）。
keystore.properties
android/keystore.properties

# ★ 例外：Gradle wrapper 的 jar **必须**入库 —— CI 上没有它就 ./gradlew 起不来，
#   源码备份里少了它，换台机器也构建不了。
#   写在最后、用 ! 反选：这是 android/ 这一节里唯一要进仓库的二进制。
!android/gradle/wrapper/gradle-wrapper.jar
