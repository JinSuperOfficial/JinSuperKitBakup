{
  "name": "jinsuper-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "JinSuper 百宝箱 桌面版 —— 把 jinsuper.rth1.xyz 那套静态网页装进一个 Electron 窗口：默认走云端主站，连不上自动回落内置离线副本；每个页面顶上都有统一的 topbar（上一页 / 主页 / 工具站 / 班级工具箱 / 博客 / 设置 / 退出）。",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "electron . --smoke",
    "pack:win": "electron-builder --win dir --x64",
    "dist:win": "electron-builder --win portable --x64",
    "test": "node --test"
  },
  "author": "JinSuper",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "xyz.jinsuper.desktop",
    "productName": "JinSuper",
    "copyright": "Copyright © JinSuper",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "src/**/*",
      "!**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../jinsuper.rth1.xyz",
        "to": "site",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "JinSuper-${version}-portable.exe"
    },
    "portable": {
      "artifactName": "JinSuper-${version}-portable.exe",
      "requestExecutionLevel": "user",
      "unpackDirName": "JinSuperDesktop"
    },
    "compression": "normal"
  }
}
