{
  "name": "jinsuper-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "JinSuper 百宝箱 桌面版 —— 把 jinsuper.rth1.xyz 那套静态网页装进一个 Electron 窗口：默认走云端主站，连不上自动回落内置离线副本；每个页面顶上都有统一的 topbar（上一页 / 主页 / 工具站 / 班级工具箱 / 博客 / 设置 / 退出）。",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "sync:config": "node build/make-sync-config.mjs",
    "prepack:win": "node build/make-sync-config.mjs",
    "predist:win": "node build/make-sync-config.mjs",
    "predist:portable": "node build/make-sync-config.mjs",
    "predist:setup": "node build/make-sync-config.mjs",
    "dev": "electron . --dev",
    "smoke": "electron . --smoke",
    "smoke:show": "electron . --smoke --show",
    "pack:win": "electron-builder --win dir --x64",
    "dist:win": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:setup": "electron-builder --win nsis --x64",
    "release:upload": "node build/upload-release.mjs",
    "test": "node --test"
  },
  "author": "JinSuper",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "xyz.jinsuper.desktop",
    "productName": "JinSuper",
    "copyright": "Copyright © JinSuper",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "src/**/*",
      "!**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../jinsuper.rth1.xyz",
        "to": "site",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../sync/lib",
        "to": "sync/lib"
      },
      {
        "from": "build",
        "to": ".",
        "filter": [
          "sync-config.json",
          "icon.ico",
          "icon-hwk.ico"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "JinSuper-${version}-portable.exe",
      "requestExecutionLevel": "user",
      "unpackDirName": "JinSuperDesktop"
    },
    "nsis": {
      "artifactName": "JinSuper-811-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "811 套装",
      "uninstallDisplayName": "811 套装 ${version}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "differentialPackage": false,
      "menuCategory": "811 套装",
      "include": "build/installer.nsh"
    },
    "compression": "normal"
  }
}
