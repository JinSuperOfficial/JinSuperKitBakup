<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ 的备份 / 换机规则。口径和 backup_rules.xml 一致：
  作业数据（files/hwk/）跟着走；同步队列、站点缓存、网页数据不跟。
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="hwk/" />
        <exclude domain="file" path="sync/" />
        <exclude domain="file" path="site/" />
        <exclude domain="cache" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="hwk/" />
        <exclude domain="file" path="sync/" />
        <exclude domain="file" path="site/" />
    </device-transfer>
</data-extraction-rules>
