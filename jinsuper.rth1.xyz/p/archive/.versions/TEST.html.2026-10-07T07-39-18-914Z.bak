<link rel="stylesheet" href="../docs-md.css">
<style>
/* 主题 token：构建时从 build/template/docs.html 抠出来（build/lib/theme.mjs），别抄第二遍 */
/* 下面这一段是从 build/template/docs.html 里抠出来的（build/lib/theme.mjs），
   改配色请改模板，改完重新构建。 */
:root{
  --mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,monospace;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  --ease:cubic-bezier(.2,.7,.2,1);

  /* ── 圆角：macOS 风格层级 token ──
     一个页面里只有这几档，别的写法一律不出现。
     档位与用法见 .Skills/theme-plus/references/circle_angle.md：
       4px 标签 / 徽章 · 6px 小控件 · 8px 按钮输入框 · 10px 卡片 · 12px 窗口弹窗
     胶囊只留给开关、状态点、独立浮起的小按钮。
     --radius-*   按组件取用（语义）
     --radius-<层级>-px   …-px 是给嵌套元素做同心计算的数字版本
     --curve       连续曲率开关：squircle 由 @supports 渐进增强，不支持就退回普通圆角 */
  --radius-xs:4px;
  --radius-sm:6px;
  --radius-md:8px;
  --radius-lg:10px;
  --radius-xl:12px;
  --radius-pill:999px;

  --radius-window:var(--radius-xl);
  --radius-card:var(--radius-lg);
  --radius-control:var(--radius-md);
  --radius-badge:var(--radius-xs);
  --radius-pill-ctl:var(--radius-pill);
  --radius-inner:var(--radius-sm);

  /* 连续曲率：只在 @supports (corner-shape:squircle) 的浏览器里生效，
     不支持就当它不存在，圆角退回上面这几档 */
  --curve:squircle;

  --sidebar-w:300px;
  --bar-h:52px;
  /* 站点顶栏高度：main-bar 的 sticky 偏移、目录跳转的落点都按它算 */
  --nav-h:40px;
  --fs-md:15px;

  /* 顶栏半透明：不透明度 + 光学参数，各效果在 html[data-glass] 里覆盖 */
  --bar-alpha:78%;
  --glass-blur:14px;
  --glass-sat:160%;
  --glass-bright:100%;
  --glass-sheen:none;
  --glass-size:auto;
  --glass-blend:normal;
}

[data-theme="obsidian"]{
  --bg:#0E1214; --panel:#13181B; --raised:#191F23;
  --line:#232C31; --line-soft:#1A2226;
  --ink:#E7E9E6; --dim:#929EA4; --faint:#869298;
  --accent:#D97757;
  --accent-soft:rgba(215,119,87,.12);
  --accent-line:rgba(215,119,87,.36);
  --md-ink:#DCE0DE; --md-dim:#9AA5AB;
  --md-code-bg:#0A0D0F; --md-code-inline:#1C2429;
  --bar-bg:rgba(19,24,27,.78);
  --shadow:0 20px 50px -28px rgba(0,0,0,.72), 0 2px 10px -6px rgba(0,0,0,.5);
}
