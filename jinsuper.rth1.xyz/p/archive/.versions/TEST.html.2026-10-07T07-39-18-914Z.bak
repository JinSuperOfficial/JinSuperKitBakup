html[data-glass="mica"]{
  --glass-blur:6px; --glass-sat:130%; --glass-bright:100%;
  --glass-sheen:linear-gradient(180deg,
    rgba(255,255,255,.05) 0%,
    rgba(255,255,255,0) 58%,
    rgba(0,0,0,.06) 100%);
  --glass-blend:normal;
}
html[data-glass="aero"]{
  --glass-blur:22px; --glass-sat:190%; --glass-bright:106%;
  --glass-sheen:linear-gradient(180deg,
    rgba(255,255,255,.22) 0%,
    rgba(255,255,255,.07) 42%,
    rgba(255,255,255,0) 64%,
    rgba(0,0,0,.06) 100%);
  --glass-blend:screen;
}
html[data-glass="acrylic"]{
  --glass-blur:28px; --glass-sat:150%; --glass-bright:100%;
  --glass-sheen:
    radial-gradient(circle at 0 0,rgba(255,255,255,.13) 0 1px,rgba(255,255,255,0) 1.6px),
    linear-gradient(180deg,rgba(255,255,255,.06) 0%,rgba(0,0,0,.05) 100%);
  --glass-size:4px 4px,auto;
  --glass-blend:normal;
}
/* 文章外壳：和 /p/post/*.html 是同一份（build/template/post-chrome.css） */
/* ═══════════════════════════════════════════════════
   文章外壳的样式（顶栏 + 两列布局 + 侧栏目录 + 上下篇 + 页脚）
   ---------------------------------------------------
   这一份被两处共用，**不要再抄第二遍**：
     · 构建期的静态文章页 `/p/post/*.html`（build/build.mjs 注入）
     · 控制台烘的归档稿 `/p/archive/*.html`（console/lib/render.mjs）
   正文排版在 docs-md.css（阅读器与这两处共用），这里只管外壳。
   配色 token 不在这儿：从 build/template/docs.html 抠（build/lib/theme.mjs）。
   ═══════════════════════════════════════════════════ */

/* 这一页的顶栏本身就是站点的栏（--bar-h），没有额外的 --nav-h */
:root{ --nav-h:0px }

*,*::before,*::after{box-sizing:border-box}
html{ -webkit-text-size-adjust:100%; }
body{
  margin:0;
  min-height:100dvh;
  background:var(--bg);
  color:var(--md-ink);
  font-family:var(--sans);
  font-size:var(--fs-md);
  line-height:1.72;
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
}
a{ color:var(--accent); }
:focus-visible{ outline:2px solid var(--accent); outline-offset:2px; border-radius:var(--radius-xs); }

/* ---------- 顶栏 ---------- */
.top{
  position:sticky; top:0; z-index:10;
  display:flex; align-items:center; gap:14px;
  min-height:var(--bar-h);
  padding:0 20px;
  border-bottom:1px solid var(--line);
  background:var(--bar-bg);
  backdrop-filter:blur(var(--glass-blur)) saturate(var(--glass-sat)) brightness(var(--glass-bright));
  background-blend-mode:var(--glass-blend);
}
.brand{
  display:flex; align-items:center; gap:9px;
  min-width:0;
  color:var(--ink);
  text-decoration:none;
  font-weight:640;
  letter-spacing:-.01em;
  white-space:nowrap;
}
.brand svg{ width:20px; height:20px; flex:none; color:var(--accent); }
.brand-sub{
  color:var(--faint);
  font-family:var(--mono);
  font-size:11.5px;
  font-weight:400;
  overflow:hidden; text-overflow:ellipsis;
}
.top-nav{
  margin-left:auto;
  display:flex; align-items:center; gap:4px;
  font-size:13px;
}
.top-nav a{
  padding:6px 10px;
  border-radius:var(--radius-control);
  color:var(--dim);
  text-decoration:none;
  transition:color .14s var(--ease), background .14s var(--ease);
}
.top-nav a:hover{ color:var(--ink); background:color-mix(in srgb,var(--ink) 6%,transparent); }

/* ---------- 正文区 ---------- */
/* 有目录时是「左一列侧栏目录 + 右边文章」，没有目录就整幅给文章。
   ---------------------------------------------------
   单列是**默认**，两列才是有目录的例外：没有目录时如果还摆着两列网格，
   文章会掉进 212px 的第一列里被挤成一条（`.has-toc` 由生成方决定）。 */
.wrap{
  --toc-w:212px;
  max-width:1120px;
  margin:0 auto;
  padding:0 20px 80px;
  display:block;
}
.wrap.has-toc{
  display:grid;
  grid-template-columns:var(--toc-w) minmax(0,1fr);
  gap:8px 34px;
  align-items:start;
}

/* ---------- 侧栏目录 ---------- */
.ptoc{
  position:sticky;
  top:calc(var(--bar-h) + 20px);
  max-height:calc(100dvh - var(--bar-h) - 44px);
  overflow-y:auto;
  padding:44px 0 24px;
  scrollbar-width:thin;
  scrollbar-color:var(--line) transparent;
}
.ptoc-title{
  margin:0 0 10px;
  font-family:var(--mono);font-size:10.5px;font-weight:600;
  letter-spacing:.13em;text-transform:uppercase;
  color:var(--faint);
}
.ptoc ul{ list-style:none;margin:0;padding:0 }
.ptoc li{ margin:0 }
.ptoc a{
  display:block;
  padding:4px 8px;
  font-size:12.5px;line-height:1.5;
  color:var(--dim);
  text-decoration:none;
  border-left:2px solid transparent;
  border-radius:0 var(--radius-xs) var(--radius-xs) 0;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  transition:color .13s var(--ease),border-color .13s var(--ease),background .13s var(--ease);
}
/* 层级：按标题级别缩进 + 字号递减（层级由 normalizeTocLevels 归一，
   最浅的一级就是 lv-1，所以「从 h2 起」的文章也不会平白缩进一整格） */
.ptoc .lv-1 a{ font-weight:620; color:var(--ink) }
.ptoc .lv-2 a{ padding-left:16px }
.ptoc .lv-3 a{ padding-left:30px; font-size:12px; color:var(--faint) }
.ptoc a:hover{ color:var(--ink); background:color-mix(in srgb,var(--ink) 5%,transparent) }
.ptoc a.active{ color:var(--accent); border-left-color:var(--accent); background:var(--accent-soft) }
.ptoc .lv-3 a:hover,
.ptoc .lv-3 a.active{ color:var(--accent) }

/* ---------- 正文 ---------- */
.md{
  max-width:820px;
  margin:0 auto;
  padding:44px 0 40px;
  font-size:var(--fs-md);
  line-height:1.78;
  color:var(--md-ink);
  word-wrap:break-word;
}
/* 阅读器里的 .md 自带 40px 左右内边距（那是它嵌在面板里的缘故）；
   这里页面本身就是留白，所以收窄一点，窄屏不再二次缩进。 */
@media (max-width:640px){
  .md{ padding:28px 0 32px; font-size:14.5px }
  .top{ padding:0 14px }
  .wrap{ padding:0 16px 60px }
}

/* ---------- 文章头（frontmatter 元数据）用的间距微调 ---------- */
.md .md-fm{ margin-top:0 }

/* 目录里「没有小节」时的兜底条目指向正文容器本身，跳回来别被吸顶栏盖住 */
#post{ scroll-margin-top:calc(var(--bar-h) + 14px) }

/* ---------- 上下篇 ---------- */
.pn{
  grid-column:2;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin:8px auto 0;
  padding:20px 0 0;
  border-top:1px solid var(--line-soft);
  max-width:820px;
}
.pn a{
  display:block;
  padding:12px 14px;
  border:1px solid var(--line);
  border-radius:var(--radius-card);
  background:var(--panel);
  text-decoration:none;
  color:var(--ink);
  transition:border-color .14s var(--ease), transform .14s var(--ease);
}
.pn a:hover{ border-color:var(--accent-line); transform:translateY(-2px) }
.pn .pn-k{
  display:block;
  margin-bottom:4px;
  font-family:var(--mono);
  font-size:11px;
  color:var(--faint);
}
.pn .pn-t{ font-size:14px; font-weight:600; line-height:1.45 }
.pn .pn-next{ text-align:right }
.pn .pn-empty{
  padding:12px 14px;
  border:1px dashed var(--line);
  border-radius:var(--radius-card);
  color:var(--faint);
  font-family:var(--mono);
  font-size:12px;
}

/* ---------- 页脚 ---------- */
.foot{
  grid-column:2;
  max-width:820px;
  margin:0 auto;
  padding:26px 0 0;
  border-top:1px solid var(--line-soft);
  color:var(--faint);
  font-size:12.5px;
  line-height:1.9;
}
.foot a{ color:var(--dim); text-decoration:none; border-bottom:1px solid var(--line) }
.foot a:hover{ color:var(--ink); border-bottom-color:var(--accent) }
.foot-row{ display:flex; flex-wrap:wrap; gap:6px 16px; align-items:center }

/* ---------- 代码复制按钮（脚本注入；没有脚本也不影响阅读） ---------- */
.md pre{ position:relative }
.md .md-copy{
  position:absolute; top:8px; right:8px;
  display:inline-flex; align-items:center; gap:5px;
  padding:4px 8px;
  border:1px solid var(--line);
  border-radius:var(--radius-badge);
  background:color-mix(in srgb,var(--panel) 88%,transparent);
  color:var(--dim);
  font-family:var(--mono); font-size:11px;
  cursor:pointer;
  opacity:0;
  transition:opacity .14s var(--ease), color .14s var(--ease), border-color .14s var(--ease);
}
.md pre:hover .md-copy,
.md .md-copy:focus-visible{ opacity:1 }
.md .md-copy:hover{ color:var(--accent); border-color:var(--accent-line) }

/* 代码组 / 选项卡的按钮由脚本生成，标签样式已在 docs-md.css 里 */
.md .cg-tabs:empty{ display:none }

/* ── 没有脚本时（爬虫、或读者关了 JS）──
   折叠类的内容全部摊开：剧透、选项卡的其它面板、代码组的其它代码块。
   宁可全露，也不能因为缺 JS 就凭空消失 —— 搜索引擎吃到的就是这一份。
   用 .has-js 而不是 <noscript><style>：后者在部分浏览器里照样生效，
   脚本开着的时候会把折叠面板全都撑开（实测踩过）。 */
html:not(.has-js) .md .md-spoiler-body,
html:not(.has-js) .md .tabs-tab-content,
html:not(.has-js) .md .cg-panel{ display:block }

@media (max-width:900px){
  /* 单列：目录放到文章前面，变成一块普通的开头内容 */
  .wrap,
  .wrap.has-toc{ display:block }
  .ptoc{
    position:static;
    max-height:none;
    overflow:visible;
    padding:28px 0 0;
  }
  .ptoc-title{ margin-bottom:8px }
}
@media (max-width:640px){
  .top-nav a.wide{ display:none }
  .pn{ grid-template-columns:1fr }
  .pn .pn-next{ text-align:left }
  .top-nav a{ padding:6px 8px }
}
@media (prefers-reduced-motion:reduce){
  *{ animation-duration:.01ms !important; transition-duration:.01ms !important }
  .pn a:hover{ transform:none }
}

</style>
</head>
